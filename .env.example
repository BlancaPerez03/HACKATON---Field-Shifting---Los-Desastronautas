# Copy to .env (never commit .env). Everything is optional: `python run.py` creates .env and,
# if you accept, fills EE_PROJECT_ID for you (`python run.py --setup` to redo it).
# Without EE_PROJECT_ID the app runs with the no-login sources (NASA POWER, USDA SSURGO, USDA CropScape);
# Earth Engine adds NDVI, SMAP and the 30 m slope / risk zones.
EE_PROJECT_ID=
# Production only: path to a service-account key (roles/earthengine.writer + roles/serviceusage.serviceUsageConsumer).
# Prefer the platform identity (e.g. Cloud Run) and leave this empty.
GOOGLE_APPLICATION_CREDENTIALS=
FS_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FS_POINT_BUFFER_M=50
FS_MAX_AREA_HA=1000
FS_MAX_VERTICES=2000
FS_DEFAULT_YEARS=10
FS_MAX_YEARS=25
FS_CACHE_DIR=
